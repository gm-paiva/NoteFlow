# Copie este arquivo para ".env" e ajuste os valores:
#   cp .env.example .env
# O ".env" é ignorado pelo Git. Nunca versione segredos.

# Ambiente de execução: development | production
NODE_ENV=development

# Porta em que a aplicação escuta.
# (No Docker Compose, é a porta publicada no seu computador.)
PORT=3000

# Endereço de escuta. Use 127.0.0.1 para acesso apenas local.
# No Docker o valor é definido automaticamente como 0.0.0.0.
HOST=127.0.0.1
